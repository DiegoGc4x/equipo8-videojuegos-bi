   "source": [
    "g7 = df[df[\"Generacion\"] == 7]\n",
    "\n",
    "grupos = [g[\"Global_Sales\"].values for _, g in g7.groupby(\"Genre\")]\n",
    "H, p1 = stats.kruskal(*grupos)\n",
    "eps2 = (H - len(grupos) + 1) / (len(g7) - len(grupos))\n",
    "\n",
    "d2 = g7[g7[\"Region_Dominante\"] != \"Empate\"]\n",
    "tabla = pd.crosstab(d2[\"Genero\"], d2[\"Region_Dominante\"])\n",
    "chi2, p2, _, esp = stats.chi2_contingency(tabla)\n",
    "V = np.sqrt(chi2 / (tabla.values.sum() * (min(tabla.shape) - 1)))\n",
    "\n",
    "d3 = g7[g7[\"Fabricante\"].isin([\"Nintendo\", \"Sony\", \"Microsoft\"])]\n",
    "u, p3 = stats.mannwhitneyu(d3.loc[d3[\"First_Party\"], \"Global_Sales\"],\n",
    "                           d3.loc[~d3[\"First_Party\"], \"Global_Sales\"], alternative=\"greater\")\n",
    "r3 = 2 * u / (d3[\"First_Party\"].sum() * (~d3[\"First_Party\"]).sum()) - 1\n",
    "\n",
    "pd.DataFrame({\"p_valor\": [p1, p2, p3], \"efecto\": [eps2, V, r3]},\n",
    "             index=[\"H1 (ε²)\", \"H2 (V)\", \"H3 (r)\"]).assign(\n",
    "    decision=lambda t: np.where(t[\"p_valor\"] < ALFA, \"Se rechaza H0\", \"No se rechaza H0\"))"
   ]
  },
