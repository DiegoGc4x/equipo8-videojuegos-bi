   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Mediana: 0.17 M | Promedio: 0.54 M (el promedio es 3.2 veces la mediana)\n"
     ]
    }
   ],
   "source": [
    "mediana = df[\"Global_Sales\"].median()\n",
    "media = df[\"Global_Sales\"].mean()\n",
    "print(f\"Mediana: {mediana:.2f} M | Promedio: {media:.2f} M (el promedio es {media / mediana:.1f} veces la mediana)\")\n",
    "kpis.append([\"Mediana por título\", f\"{mediana:.2f} M\", \"MEDIAN(Global_Sales)\", \"H1, H3\"])"
   ]
