     "iopub.status.idle": "2026-10-19T06:12:42.624356Z",
     "shell.execute_reply": "2026-10-19T06:12:42.623724Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Ventas totales: 8,820.0 M de unidades en 16,322 títulos-plataforma\n",
      "Año pico: 2008 (678.9 M)\n"
     ]
    }
   ],
   "source": [
    "ventas_totales = df[\"Global_Sales\"].sum()\n",
    "titulos = len(df)\n",
    "print(f\"Ventas totales: {ventas_totales:,.1f} M de unidades en {titulos:,} títulos-plataforma\")\n",
    "kpis.append([\"Ventas globales\", f\"{ventas_totales:,.1f} M\", \"SUM(Global_Sales)\", \"Base\"])\n",
    "\n",
    "anual = df[df[\"Anio_Completo\"]].groupby(\"Year\")[\"Global_Sales\"].sum()\n",
    "print(\"Año pico:\", anual.idxmax(), f\"({anual.max():.1f} M)\")"
   ]
  },
