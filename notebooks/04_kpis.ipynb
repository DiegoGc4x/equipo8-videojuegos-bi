   "source": [
    "d3 = df[df[\"Fabricante\"].isin([\"Nintendo\", \"Sony\", \"Microsoft\", \"Sega\"])]\n",
    "med_fp = d3.loc[d3[\"First_Party\"], \"Global_Sales\"].median()\n",
    "med_tp = d3.loc[~d3[\"First_Party\"], \"Global_Sales\"].median()\n",
    "prima = med_fp / med_tp\n",
    "part_fp = df.loc[df[\"First_Party\"], \"Global_Sales\"].sum() / ventas_totales\n",
    "\n",
    "print(f\"Prima first-party: {prima:.1f}x  ({med_fp:.2f} M vs {med_tp:.2f} M)\")\n",
    "print(f\"Participación first-party en ventas totales: {part_fp:.1%}, con {df['First_Party'].mean():.1%} de los títulos\")\n",
    "kpis.append([\"Prima first-party\", f\"{prima:.1f}x\", \"MEDIAN(first-party) / MEDIAN(terceros)\", \"H3\"])\n",
    "kpis.append([\"Participación first-party\", f\"{part_fp:.1%}\", \"Ventas first-party / ventas totales\", \"H3\"])\n",
    "\n",
    "prima_fab = (d3.groupby([\"Fabricante\", \"First_Party\"])[\"Global_Sales\"].median().unstack())\n",
    "(prima_fab[True] / prima_fab[False]).round(1).rename(\"prima\").to_frame()"
   ]
