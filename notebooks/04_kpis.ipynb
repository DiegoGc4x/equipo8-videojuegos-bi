   "source": [
    "por_genero = df.groupby(\"Genero\")[reg].sum().rename(columns=estilo.REGIONES)\n",
    "share_genero = por_genero.div(por_genero.sum(axis=1), axis=0)\n",
    "afinidad = share_genero / part_region\n",
    "afinidad = afinidad.sort_values(\"Japón\", ascending=False)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6.5, 5.5))\n",
    "lim = np.abs(np.log2(afinidad.values)).max()\n",
    "im = ax.imshow(np.log2(afinidad.values), cmap=\"RdBu_r\", vmin=-lim, vmax=lim, aspect=\"auto\")\n",
    "ax.set_xticks(range(4), afinidad.columns)\n",
    "ax.set_yticks(range(len(afinidad)), afinidad.index)\n",
    "ax.grid(False)\n",
    "for i in range(afinidad.shape[0]):\n",
    "    for j in range(afinidad.shape[1]):\n",
    "        v = afinidad.values[i, j]\n",
    "        ax.text(j, i, f\"{v:.2f}\", ha=\"center\", va=\"center\", fontsize=9,\n",
    "                color=\"white\" if abs(np.log2(v)) > lim * 0.55 else \"#0b0b0b\")\n",
    "ax.set_title(\"Índice de afinidad regional (1 = promedio)\")\n",
    "estilo.guardar(fig, \"kpi_afinidad_regional\")\n",
    "plt.show()\n",
    "\n",
    "kpis.append([\"Afinidad Rol (RPG) en Japón\", f\"{afinidad.loc['Rol (RPG)', 'Japón']:.2f}\",\n",
    "             \"Share región en género / share región total\", \"H2\"])\n",
    "afinidad.round(2)"
   ]
  },
