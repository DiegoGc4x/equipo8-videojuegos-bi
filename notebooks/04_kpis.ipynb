    "# curva de concentración: títulos ordenados de más a menos vendido\n",
    "orden = df[\"Global_Sales\"].sort_values(ascending=False)\n",
    "acum_ventas = np.r_[0, orden.cumsum().values / ventas_totales]\n",
    "acum_titulos = np.linspace(0, 1, len(acum_ventas))\n",
    "fig, ax = plt.subplots(figsize=(5.5, 4.5))\n",
    "ax.plot(acum_titulos * 100, acum_ventas * 100, color=estilo.AZUL, lw=2)\n",
    "ax.plot([0, 100], [0, 100], color=estilo.GRIS, ls=\"--\", lw=1)\n",
    "ax.scatter([tasa_hits * 100], [ventas_hits * 100], color=estilo.NARANJA, zorder=3, s=40)\n",
    "ax.annotate(f\"Hits: {tasa_hits:.1%} de los títulos\\n= {ventas_hits:.1%} de las ventas\",\n",
    "            (tasa_hits * 100, ventas_hits * 100), xytext=(28, 48), fontsize=9,\n",
    "            arrowprops=dict(arrowstyle=\"-\", color=estilo.GRIS))\n",
    "ax.set_xlabel(\"% de títulos (de más a menos vendido)\")\n",
    "ax.set_ylabel(\"% acumulado de ventas\")\n",
    "ax.set_title(\"Curva de concentración\")\n",
    "estilo.guardar(fig, \"kpi_concentracion\")\n",
    "plt.show()"
   ]
