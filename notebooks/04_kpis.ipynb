    "ventas_hits = df.loc[df[\"Exito_1M\"], \"Global_Sales\"].sum() / ventas_totales\n",
    "top10_pub = df.groupby(\"Publisher\")[\"Global_Sales\"].sum().nlargest(10).sum() / ventas_totales\n",
    "\n",
    "print(f\"Los hits son el {tasa_hits:.1%} de los títulos y generan el {ventas_hits:.1%} de las ventas\")\n",
    "print(f\"Top 10 publishers: {top10_pub:.1%} de las ventas (de {df['Publisher'].nunique()} publishers)\")\n",
    "kpis.append([\"Participación de los hits en ventas\", f\"{ventas_hits:.1%}\", \"Ventas títulos >= 1 M / ventas totales\", \"H1, H3\"])\n",
