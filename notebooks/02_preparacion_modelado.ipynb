    "import sys\n",
    "sys.path.append(\"../src\")\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import estilo #se usa para ahorrar codigo, trae las rutas, diccionario, colores\n",
    "\n",
    "df = pd.read_csv(estilo.RAW)\n",
    "n_inicial = len(df)\n",
    "ventas_inicial = df[\"Global_Sales\"].sum()\n",
    "print(n_inicial, round(ventas_inicial, 2))"
   ]
  },
