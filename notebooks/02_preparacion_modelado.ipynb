     ]
    }
   ],
   "source": [
    "base = (df.merge(dim_plataforma[[\"id_plataforma\", \"Platform\"]], on=\"Platform\")\n",
    "          .merge(dim_genero[[\"id_genero\", \"Genre\"]], on=\"Genre\")\n",
    "          .merge(dim_publisher[[\"id_publisher\", \"Publisher\"]], on=\"Publisher\"))\n",
    "\n",
    "fact = base.melt(id_vars=[\"ID_Registro\", \"id_plataforma\", \"id_genero\", \"id_publisher\",\n",
    "                          \"Year\", \"First_Party\", \"Exito_1M\"],\n",
    "                 value_vars=reg, var_name=\"col_region\", value_name=\"ventas_m\")\n",
    "fact[\"id_region\"] = fact[\"col_region\"].map({\"NA_Sales\": 1, \"EU_Sales\": 2, \"JP_Sales\": 3, \"Other_Sales\": 4})\n",
    "fact = (fact.drop(columns=\"col_region\")\n",
    "            .rename(columns={\"ID_Registro\": \"id_registro\", \"Year\": \"anio\",\n",
    "                             \"First_Party\": \"first_party\", \"Exito_1M\": \"exito_1m\"})\n",
    "            .sort_values([\"id_registro\", \"id_region\"]).reset_index(drop=True))\n",
    "\n",
    "assert len(fact) == len(df) * 4\n",
    "assert fact[\"id_plataforma\"].notna().all() and fact[\"id_genero\"].notna().all()\n",
    "\n",
    "tablas = {\"fact_ventas\": fact, \"dim_plataforma\": dim_plataforma, \"dim_genero\": dim_genero,\n",
    "          \"dim_publisher\": dim_publisher, \"dim_tiempo\": dim_tiempo, \"dim_region\": dim_region,\n",
    "          \"dim_juego\": dim_juego}\n",
    "for nombre, t in tablas.items():\n",
    "    t.to_csv(modelo / f\"{nombre}.csv\", index=False, encoding=\"utf-8\")\n",
    "    print(f\"{nombre:16s} {t.shape}\")"
   ]
  }
