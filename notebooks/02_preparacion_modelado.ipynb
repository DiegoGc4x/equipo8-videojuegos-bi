     "text": [
      "fact_ventas      (65288, 9)\n",
      "dim_plataforma   (31, 6)\n",
      "dim_genero       (12, 3)\n",
      "dim_publisher    (576, 3)\n",
      "dim_tiempo       (37, 3)\n",
      "dim_region       (4, 3)\n",
