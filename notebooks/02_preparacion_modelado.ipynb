   "source": [
    "# participación de cada región dentro del título\n",
    "total_reg = df[reg].sum(axis=1).replace(0, np.nan)\n",
    "for col, corto in zip(reg, [\"NA\", \"EU\", \"JP\", \"Otros\"]):\n",
    "    df[f\"Share_{corto}\"] = df[col] / total_reg\n",
    "\n",
    "# región dominante entre los tres mercados grandes.\n",
    "tres = df[[\"NA_Sales\", \"EU_Sales\", \"JP_Sales\"]]\n",
    "maximo = tres.max(axis=1)\n",
    "empate = tres.eq(maximo, axis=0).sum(axis=1) > 1\n",
    "df[\"Region_Dominante\"] = tres.idxmax(axis=1).map({\"NA_Sales\": \"Norteamérica\",\n",
    "                                                   \"EU_Sales\": \"Europa\", \"JP_Sales\": \"Japón\"})\n",
    "df.loc[empate, \"Region_Dominante\"] = \"Empate\"\n",
    "\n",
    "df[\"Exito_1M\"] = df[\"Global_Sales\"] >= 1\n",
    "df[\"Region_Dominante\"].value_counts()"
   ]
  },
