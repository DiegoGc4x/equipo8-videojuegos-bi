   "source": [
    "# first-party: el publisher es el mismo dueño de la plataforma\n",
    "publishers_fabricante = {\n",
    "    \"Nintendo\": [\"Nintendo\"],\n",
    "    \"Sony\": [\"Sony Computer Entertainment\", \"Sony Computer Entertainment Europe\",\n",
    "             \"Sony Computer Entertainment America\"],\n",
    "    \"Microsoft\": [\"Microsoft Game Studios\"],\n",
    "    \"Sega\": [\"Sega\"],\n",
    "}\n",
    "df[\"First_Party\"] = [pub in publishers_fabricante.get(fab, [])\n",
    "                     for pub, fab in zip(df[\"Publisher\"], df[\"Fabricante\"])]\n",
    "\n",
    "df.groupby(\"Fabricante\")[\"First_Party\"].agg([\"sum\", \"size\"]).sort_values(\"size\", ascending=False)"
   ]
  },
