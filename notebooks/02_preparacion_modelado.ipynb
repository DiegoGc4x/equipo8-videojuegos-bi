    "cols_ventas = [\"NA_Sales\", \"EU_Sales\", \"JP_Sales\", \"Other_Sales\", \"Global_Sales\"]\n",
    "\n",
    "principal = df.index[df[\"Rank\"] == 604][0]\n",
    "partido = df.index[df[\"Rank\"] == 16130][0]\n",
    "df.loc[principal, cols_ventas] += df.loc[partido, cols_ventas].values\n",
    "df = df.drop(index=partido)\n",
    "\n",
    "df = df.drop_duplicates(subset=[\"Name\", \"Platform\", \"Year\", \"Publisher\"], keep=\"first\")\n",
    "print(len(df))"
   ]
